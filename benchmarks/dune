(env
 (dev
  (flags
   (:standard -w -58))))

(library
 (name re_benchmarks)
 (modules
  automata_cases
  capture_histories
  cases
  common_patterns
  edge_patterns
  frontend_cases
  http
  id_patterns
  import
  memory_patterns
  pattern
  suite
  tex
  workload
  workload_tests)
 (libraries
  re_private
  re_test_util
  base
  stdio
  ppx_expect.config
  ppx_expect.config_types
  ppx_expect_common
  ppx_inline_test.config)
 (inline_tests
  (deps
   benchmarks/files
   benchmarks/http-requests.txt
   benchmarks/tex.gitignore
   (glob_files benchmarks/gitignore/*)))
 (preprocess
  (pps ppx_expect)))

;; The inline-test runner starts in this directory, while the benchmark inputs
;; use paths relative to the project root.

(subdir
 benchmarks
 (copy_files ../{files,http-requests.txt,tex.gitignore})
 (subdir
  gitignore
  (copy_files ../../gitignore/*)))

(executable
 (libraries
  re_benchmarks
  re
  re_private
  core
  base
  stdio
  threads
  core_bench
  core_unix.command_unix
  memtrace)
 (modules benchmark)
 (name benchmark))

(rule
 (alias runtest)
 (deps files http-requests.txt tex.gitignore)
 (action
  (chdir
   %{workspace_root}
   (setenv
    RE_BENCH_FILTER
    http
    (ignore-stdout
     (run %{exe:benchmark.exe} -thin-overhead 1))))))

(rule
 (alias runtest)
 (deps files http-requests.txt tex.gitignore)
 (action
  (chdir
   %{workspace_root}
   (setenv
    RE_BENCH_FILTER
    "expression IDs/broad/16/1024,expression IDs/narrow/1024"
    (ignore-stdout
     (run %{exe:benchmark.exe} -thin-overhead 1))))))

(rule
 (alias runtest)
 (deps
  files
  http-requests.txt
  tex.gitignore
  (glob_files gitignore/*))
 (action
  (chdir
   %{workspace_root}
   (setenv
    RE_BENCH_FILTER
    "capture histories/,automata/tiny,parser/empty,literal/anchored/32,gitignore/latex-ignore-suffixes/noncapturing"
    (ignore-stdout
     (run %{exe:benchmark.exe} -thin-overhead 1))))))

;; Phase filters must not initialize unrelated, potentially multi-GiB workloads.

(rule
 (alias runtest)
 (deps files http-requests.txt tex.gitignore)
 (action
  (chdir
   %{workspace_root}
   (setenv
    RE_BENCH_FILTER
    "automata/tiny/execp/warm,parser/empty/parse,expression IDs/narrow/1024/exec_opt/cold,expression IDs/narrow/1024/exec/build+compile+exec,uri/input/1/exec/warm"
    (ignore-stdout
     (run %{exe:benchmark.exe} -thin-overhead 1))))))

(rule
 (alias runtest)
 (deps files http-requests.txt tex.gitignore)
 (action
  (chdir
   %{workspace_root}
   (setenv
    RE_BENCH_FILTER
    "edge/nested-repetition/"
    (ignore-stdout
     (run %{exe:benchmark.exe} -thin-overhead 1))))))

(executable
 (name stats)
 (modules stats)
 (libraries re_benchmarks))

