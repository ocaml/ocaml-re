(library
 (name re_tests)
 (modules
  (:standard \ test_stats))
 (libraries
  re_private
  ;; This is because of the (implicit_transitive_deps false)
  ;; in dune-project
  ppx_expect.config
  ppx_expect.config_types
  ppx_expect
  ppx_expect_common
  base
  str
  ppx_inline_test.config)
 (inline_tests
  (modes native js))
 (preprocess
  (pps ppx_expect)))

;; Reachable-word snapshots depend on the native heap representation.

(library
