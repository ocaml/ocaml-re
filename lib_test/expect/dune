 (libraries
  re_private
  base
  ppx_expect.config
  ppx_expect.config_types
  ppx_expect_common
  ppx_inline_test.config)
 (inline_tests
  (modes native))
 (preprocess
  (pps ppx_expect)))

;; ppx_expect v16 depends on ppx_expect.common

(subdir
 ppx_expect_common
 (library
  (name ppx_expect_common)
  (enabled_if
   (< %{ocaml_version} 5.0))
  (libraries
   (re_export ppx_expect.common)))
 (library
  (name ppx_expect_common)
  (enabled_if
   (>= %{ocaml_version} 5.0))))

;; this hackery is needed because ppx_expect itself uses re, therefore we need to mangle
